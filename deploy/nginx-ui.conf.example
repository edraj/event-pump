# Event Pump events UI — public exposure behind nginx auth (approved model).
# The query API itself listens only on EP_INTERNAL_LISTEN (127.0.0.1:8081);
# this vhost is the sole public doorway and the auth gate.
#
#   dnf install eventpump-ui        # assets land in /usr/share/eventpump/ui
#   cp /usr/share/eventpump/nginx/eventpump-ui.conf.example \
#      /etc/nginx/conf.d/eventpump-ui.conf
#   htpasswd -c /etc/nginx/eventpump-ui.htpasswd youruser
#   nginx -t && systemctl reload nginx
#
# SELinux (enforcing by default on Fedora/EL): the assets land under
# /usr/share, which is labelled usr_t, not the httpd_sys_content_t nginx
# expects for served content, and the proxy_pass needs the network boolean:
#
#   semanage fcontext -a -t httpd_sys_content_t "/usr/share/eventpump/ui(/.*)?"
#   restorecon -Rv /usr/share/eventpump/ui
#   setsebool -P httpd_can_network_connect on
#
# Building from source instead of the RPM: `cd ui && npm ci && npm run build`
# and point `root` at ui/dist/client (or unpack a release eventpump-ui tarball).
#
# SERVING IT UNDER A SUBPATH (e.g. /ep/ui/ when the API owns the domain root).
# Two moving parts: where the assets are fetched from, and where the client
# router thinks it is mounted. Pick one of:
#
#   a. Build for the subpath — `EP_UI_BASE=/ep/ui/ npm run build`. Vite rewrites
#      the asset URLs in index.html and the router picks the base up from
#      import.meta.env.BASE_URL. Nothing to do in nginx beyond the location.
#
#   b. Relocate the prebuilt bundle — what the RPM ships is always built for
#      '/'. Set `window.EP_UI_BASE` before the app script and rewrite the asset
#      URLs on the way out, both via sub_filter:
#
#        location /ep/ui/ {
#            alias /usr/share/eventpump/ui/;
#            try_files $uri /usr/share/eventpump/ui/index.html;
#
#            sub_filter '<head>' '<head><script>window.EP_UI_BASE="/ep/ui";window.EP_QUERY_BASE="/ep";</script>';
#            sub_filter 'href="/assets/' 'href="/ep/ui/assets/';
#            sub_filter 'src="/assets/'  'src="/ep/ui/assets/';
#            sub_filter_once off;
#        }
#
#      EP_QUERY_BASE is separate because the query API is not under the UI's
#      mount point — it is wherever the API is proxied (/ep here).

server {
    listen 443 ssl;
    server_name events.example.com;

    # ssl_certificate     /etc/pki/tls/certs/events.example.com.crt;
    # ssl_certificate_key /etc/pki/tls/private/events.example.com.key;

    auth_basic           "Event Pump";
    auth_basic_user_file /etc/nginx/eventpump-ui.htpasswd;

    root /usr/share/eventpump/ui;

    # Read-only query API, proxied to the internal listener.
    #
    # The query endpoints authenticate at the app layer with the tenant's
    # server-side `internal_token` (SPEC §9.3) — the browser never sees it and
    # the bundle carries no credential, so nginx injects it here. Paste the
    # tenant's own value: the token names the tenant, and the UI then sees that
    # tenant's events and no other's. Rotating the token means editing this
    # line and reloading nginx.
    #
    # auth_basic above is still what decides WHO may reach this vhost; this
    # header only tells the API which tenant is being asked about.
    location /internal/v1/query/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer REPLACE_ME_INTERNAL_TOKEN";
    }

    # /docs (OpenAPI + Swagger UI) is deliberately NOT proxied here. The spec
    # lists every route the app maps, /internal/* included, and this vhost is
    # public. To publish it anyway, add the location below AND keep the
    # auth_basic gate above — and note that EP_DOCS=off would 404 it at the
    # source, EP_DOCS=internal keeps it off the public listener:
    #
    #     location = /docs {
    #         proxy_pass http://127.0.0.1:8081;   # canonicalising 302 to /docs/
    #         proxy_set_header Host $host;
    #     }
    #     location /docs/ {
    #         proxy_pass http://127.0.0.1:8081;   # internal listener
    #         proxy_set_header Host $host;
    #     }
    #
    # Both locations are needed: nginx prefix-matching means `location /docs/`
    # never sees a request for `/docs`, which would fall through to the SPA
    # below and answer 200 with the events UI instead of the redirect.
    #
    # The page's URLs are all relative, so it works under a subpath too — see
    # the EP_UI_BASE notes above for the equivalent UI treatment.

    # the SPA (history routing: unknown paths fall back to index.html)
    location / {
        try_files $uri /index.html;
    }
}
