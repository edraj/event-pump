{
  "openapi": "3.1.1",
  "info": {
    "title": "Event Pump API",
    "description": "Event ingestion, error intake and read-only query API. /v1/* is served on the public listener, /internal/* and /metrics on the internal one, /healthz and /docs on both.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": ".."
    }
  ],
  "paths": {
    "/v1/events": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Ingest a batch of client-origin events.",
        "description": "Up to 100 events per batch, 32KB each. Events are validated one by one: the response reports how many were accepted and why the rest were rejected. Client-origin events must carry an `anonymous_id`; without one the event is rejected with `missing_anonymous_id`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large — the request body exceeded 4MB (SPEC §9). No body is returned."
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "Bearer": []
          },
          {
            "TenantApiKeyQuery": []
          }
        ]
      }
    },
    "/v1/identity": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Upsert the identity handles of a session.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large — the request body exceeded 4MB (SPEC §9). No body is returned."
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "description": "Full context is registered once per session. The `attributes` block (SPEC §6.1) is person-scoped and merged on `user_id`; rejections include `attributes_require_user_id` and `attributes_too_large`.",
        "security": [
          {
            "Bearer": []
          },
          {
            "TenantApiKeyQuery": []
          }
        ]
      }
    },
    "/v1/errors": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Report a client-side error or crash.",
        "description": "Reports are deduped by (day, app, stack hash) and counted.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large — the request body exceeded 4MB (SPEC §9). No body is returned."
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "Bearer": []
          },
          {
            "TenantApiKeyQuery": []
          }
        ]
      }
    },
    "/internal/v1/query/events": {
      "get": {
        "tags": [
          "Query"
        ],
        "summary": "List stored events with their delivery status.",
        "description": "Newest first, cursor-paginated. The window is clamped server-side to EP_QUERY_MAX_DAYS. Authenticated with the per-tenant `internal_token` (server-side secret) and answered only on the internal listener (EP_INTERNAL_LISTEN). The token also selects the tenant: a query returns that tenant's rows and no other's. deploy/nginx-ui.conf.example injects the header for the bundled events UI and adds its own reverse-proxy auth in front.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "ISO-8601 lower bound; clamped to EP_QUERY_MAX_DAYS ago.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "ISO-8601 upper bound (default: now).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1-200, default 50.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "next_cursor from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event_name",
            "in": "query",
            "description": "Exact event name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "description": "client or server.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "description": "Exact user id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "anonymous_id",
            "in": "query",
            "description": "UUID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session_key",
            "in": "query",
            "description": "UUID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Delivery status on any destination.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "description": "Destination name, e.g. ga4.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/internal/v1/query/identity/{sessionKey}": {
      "get": {
        "tags": [
          "Query"
        ],
        "summary": "Fetch one session's identity record.",
        "parameters": [
          {
            "name": "sessionKey",
            "in": "path",
            "description": "Session key (UUID).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "description": "Authenticated with the per-tenant `internal_token` (server-side secret) and answered only on the internal listener (EP_INTERNAL_LISTEN). The token also selects the tenant: a query returns that tenant's rows and no other's. deploy/nginx-ui.conf.example injects the header for the bundled events UI and adds its own reverse-proxy auth in front.",
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/internal/v1/events": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Ingest a batch of server-origin events.",
        "description": "Same body as /v1/events; authenticated with the per-tenant `internal_token` (server-side secret, distinct from the client-side `tenant_api_key`).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large — the request body exceeded 4MB (SPEC §9). No body is returned."
          }
        }
      }
    },
    "/internal/v1/user_attributes/{appId}/{userId}": {
      "delete": {
        "tags": [
          "Administration"
        ],
        "summary": "Delete a person's stored user attributes (DSR).",
        "description": "Data-subject-request erasure of the person-scoped user_attributes row. Authenticated with a tenant's internal token; the URL's app_id must match the token's tenant or the request is rejected 401. Database-only — downstream destination cleanup is a follow-up. Idempotent: deleting an absent row is 204.",
        "parameters": [
          {
            "name": "appId",
            "in": "path",
            "required": true,
            "description": "The tenant that owns the row being erased.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The user id whose attributes are erased.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Liveness probe; 503 when the database is unreachable.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "description": "No authentication.",
        "security": []
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Prometheus exposition of the ingestion and delivery counters.",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "No authentication.",
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorReportRequest": {
        "type": "object",
        "properties": {
          "kind": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "stack": {
            "type": [
              "null",
              "string"
            ]
          },
          "anonymous_id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "session_key": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "app_version": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "screen": {
            "type": [
              "null",
              "string"
            ]
          },
          "sdk": {
            "type": [
              "null",
              "object"
            ]
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EventInput": {
        "description": "One event. `anonymous_id` is listed as optional because this schema is shared with /internal/v1/events, where server-origin events legitimately have none — on /v1/events it is REQUIRED and an event without one is rejected with `missing_anonymous_id`. Unknown top-level keys are rejected too (`unknown_field:<name>`); only the properties below are accepted.",
        "required": [
          "event_id",
          "event_name",
          "occurred_at"
        ],
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_name": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "anonymous_id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "session_key": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "user_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "properties": {
            "type": [
              "null",
              "object"
            ]
          },
          "context": {
            "type": [
              "null",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "EventsRequest": {
        "required": [
          "events"
        ],
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventInput"
            }
          }
        }
      },
      "EventsResponse": {
        "required": [
          "accepted",
          "rejected"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "format": "int32"
          },
          "rejected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RejectedEvent"
            }
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "IdentityHandles": {
        "type": "object",
        "properties": {
          "ga4_client_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "ga4_session_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "firebase_app_instance_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "amplitude_device_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "adjust_adid": {
            "type": [
              "null",
              "string"
            ]
          },
          "adjust_platform_ad_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "fbp": {
            "type": [
              "null",
              "string"
            ]
          },
          "fbc": {
            "type": [
              "null",
              "string"
            ]
          },
          "click_ids": {
            "type": [
              "null",
              "object"
            ]
          }
        }
      },
      "IdentityRequest": {
        "required": [
          "session_key",
          "anonymous_id"
        ],
        "type": "object",
        "properties": {
          "session_key": {
            "type": "string",
            "format": "uuid"
          },
          "anonymous_id": {
            "type": "string",
            "format": "uuid"
          },
          "session_number": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32",
            "minimum": 1,
            "description": "Must be a JSON number >= 1; a string is rejected with `invalid_session_number`."
          },
          "user_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "first_seen_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "handles": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IdentityHandles"
              }
            ]
          },
          "attributes": {
            "type": [
              "null",
              "object"
            ],
            "description": "Person-scoped user attributes (SPEC §6.1). Keys must be declared in the tracking plan's `attributes` allowlist; requires `user_id`; the serialized object must not exceed 4KB. Stored merged per user_id — omitting a key never deletes it."
          },
          "context": {
            "type": [
              "null",
              "object"
            ]
          }
        }
      },
      "RejectedEvent": {
        "required": [
          "index",
          "event_id",
          "reason"
        ],
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "event_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Per-tenant bearer. Use `tenant_api_key` (client key) on `/v1/*` and `internal_token` (server secret) on `/internal/v1/*`; they are separate values. Paste the key itself, without the \"Bearer \" prefix.",
        "scheme": "bearer"
      },
      "TenantApiKeyQuery": {
        "type": "apiKey",
        "name": "tenant_api_key",
        "in": "query",
        "description": "Client-side `tenant_api_key` carried in the query string when the SDK cannot set headers — specifically `navigator.sendBeacon` on page unload (SPEC §7, §9.1). Only accepted on `/v1/*`; `/internal/v1/*` requires the bearer header."
      }
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "tags": [
    {
      "name": "Ingestion"
    },
    {
      "name": "Query"
    },
    {
      "name": "Administration"
    },
    {
      "name": "Operations"
    }
  ]
}
