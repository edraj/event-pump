# Event Pump configuration (systemd EnvironmentFile, SPEC §13)
# Copy to /etc/eventpump/eventpump.env, chmod 640 root:eventpump.

# --- database (the platform's business database — the outbox lives there) ---
EP_DB_CONNSTRING=Host=127.0.0.1;Username=eventpump;Password=CHANGE_ME;Database=platform

# --- listeners ---
# Public ingestion API (behind nginx; nginx must set X-Real-IP).
EP_LISTEN=http://127.0.0.1:8080
# Internal listener: /internal/v1/events + /metrics. Firewall this port.
EP_INTERNAL_LISTEN=http://127.0.0.1:8081
# Worker /metrics + /healthz.
EP_METRICS_LISTEN=http://127.0.0.1:9090

# --- auth ---
# Client-side per-tenant API key. Ships in the mobile / web SDK bundle;
# authenticates POST /v1/*. Rotate on suspicion of leak.
EP_TENANT_API_KEY=CHANGE_ME_TENANT_API_KEY
# Server-side per-tenant secret. Authenticates POST /internal/v1/* and DSR
# DELETE. Kept out of any client bundle; MUST differ from EP_TENANT_API_KEY.
EP_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# --- web SDK cookie & CORS (SPEC §9.5) ---
# The API MUST be served from a subdomain of the site's registrable domain
# (e.g. collect.example.com) so the SameSite=Lax ep_aid cookie flows.
EP_COOKIE_DOMAIN=.example.com
EP_CORS_ORIGINS=https://www.example.com,https://m.example.com

# --- rate limiting: permits/window_seconds per token ---
EP_RATE_LIMIT=600/60
# Separate bucket for /v1/errors — an error storm never throttles events.
EP_ERROR_RATE_LIMIT=120/60

# --- events UI query window ceiling (days; aligns with daily partitions) ---
EP_QUERY_MAX_DAYS=5

# --- /docs (OpenAPI + Swagger UI): both (default) | internal | off ---
# The spec lists every route the app maps, /internal/* included. Use `internal`
# when the public listener faces the internet directly. This file is
# %config(noreplace), so an upgraded install keeps whatever is set here.
EP_DOCS=both

# --- tenants (SPEC v1.2 §13.2) ---
# Preferred: one *.jsonc file per tenant in this directory. Each file carries
# that tenant's app_id, both keys, tracking plan, CORS/cookie settings and
# destination credentials, which makes every `--- auth ---`, `--- web SDK ---`
# and destination block below dead config. See deploy/tenants/README.md.
#EP_TENANTS_DIR=/etc/eventpump/tenants
#
# Back-compat single-tenant path, used only while EP_TENANTS_DIR is unset:
# the tracking plan comes from a file and the rest from the EP_* vars above.
EP_TRACKING_PLAN=/etc/eventpump/tracking-plan.json
# app_id the synthesised tenant writes to storage. Existing rows were
# back-filled with 'zainmart' by migration 0009, so changing this on a live
# deployment splits every app_id-keyed aggregation (error_reports especially)
# at the moment you change it.
#EP_LEGACY_APP_ID=zainmart
#
# EP_CLIENT_TOKENS (pre-v1.2, app_id:token[,app_id:token...]) was removed. It
# is no longer read, and the process refuses to boot while it is still set —
# silently collapsing several app_ids into one would re-bucket stored data.

# --- retention (SPEC §11) ---
EP_RETENTION_DAYS=30
EP_RETENTION_DEAD_DAYS=90

# --- client IP handling: raw (default) | geo (pluggable resolver) ---
EP_IP_MODE=raw

# --- worker tuning (defaults shown) ---
#EP_WORKER_POLL_MS=1000
#EP_WORKER_CLAIM_BATCH=50
#EP_WORKER_SEND_CONCURRENCY=4
#EP_WORKER_BACKOFF_BASE_S=30
#EP_WORKER_BACKOFF_CAP_S=3600
#EP_WORKER_MAX_ATTEMPTS=10
#EP_WORKER_BREAKER_THRESHOLD=5
#EP_WORKER_BREAKER_PAUSE_S=120
#EP_WORKER_LEASE_S=300
#EP_SENDER_TIMEOUT_MS=10000

# --- GA4 Measurement Protocol ---
EP_GA4_ENABLED=false
EP_GA4_API_SECRET=
EP_GA4_MEASUREMENT_ID=
# App streams (Firebase) instead of / in addition to web:
#EP_GA4_FIREBASE_APP_ID=
#EP_GA4_ENDPOINT=https://www.google-analytics.com

# --- Amplitude HTTP V2 ---
EP_AMPLITUDE_ENABLED=false
EP_AMPLITUDE_API_KEY=
# EU residency: https://api.eu.amplitude.com/2/httpapi
#EP_AMPLITUDE_ENDPOINT=https://api2.amplitude.com/2/httpapi

# --- MoEngage Data API ---
EP_MOENGAGE_ENABLED=false
EP_MOENGAGE_APP_ID=
EP_MOENGAGE_API_KEY=
# Pick your data center host (api-01 .. api-06):
#EP_MOENGAGE_ENDPOINT=https://api-01.moengage.com

# --- Adjust S2S ---
EP_ADJUST_ENABLED=false
EP_ADJUST_APP_TOKEN=
# S2S security token (dashboard: Protection > S2S Security):
#EP_ADJUST_S2S_TOKEN=
#EP_ADJUST_ENDPOINT=https://s2s.adjust.com/event

# --- User attributes per destination (SPEC §6.1 / §13) ---
# When OFF, the sender still delivers the event core; only attribute-derived
# fields are omitted (user_properties, user_data, s2s_email, partner_params).
# MoEngage is the designated raw-PII destination and defaults ON; when it's
# off the type:"customer" sync path is disabled entirely.
EP_GA4_ATTRIBUTES_ENABLED=false
EP_AMPLITUDE_ATTRIBUTES_ENABLED=false
EP_MOENGAGE_ATTRIBUTES_ENABLED=true
EP_ADJUST_ATTRIBUTES_ENABLED=false
EP_META_ATTRIBUTES_ENABLED=false

# --- Meta CAPI (reference sender; DISABLED by default, SPEC §12) ---
EP_META_ENABLED=false
EP_META_PIXEL_ID=
EP_META_ACCESS_TOKEN=
#EP_META_GRAPH_VERSION=v25.0
#EP_META_TEST_EVENT_CODE=
#EP_META_CONSENT_GATING=false
#EP_META_ACTION_SOURCE=website
